# --------------------------------------------------------------------------- #
#  .gitignore for OrikaServer (C++ / MFC / MSBuild / vcpkg)                   #
#                                                                              #
#  Replaces the prior generic Node template (R14 in PROJECT_AUDIT.txt).        #
#  After committing this file, run:                                            #
#     git rm -r --cached <previously-tracked-paths>                            #
#  to untrack build outputs, IDE state, and secrets that are already in the    #
#  index (.suo, .sdf, Debug/, x64/, *.obj, key.pem, etc.).                     #
# --------------------------------------------------------------------------- #

# ===== Secrets - NEVER commit ===============================================
*.pem
*.key
*.pfx
*.p12
*.crt
*.cer
*.der
SLLCretificate/

# ===== Large archives / backups / dumps =====================================
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.bak
*.Bak

# ===== Build outputs ========================================================
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
Win32/
[Bb]uild/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Project-specific build/dep dirs that don't match the patterns above
OrikaServer/x32/
OrikaServer/x64_Lib/
OrikaServer/x64_Debug_Lib/
OrikaServer/Dependencies_Debug_64/
OrikeEXE/

# Claude Code session state (never commit)
.claude/

# ===== Non-source extensions ===============================================
# Reinforces "only push source files" - any file with one of these extensions
# anywhere in the tree won't be tracked. Source we DO want stays tracked via
# the .c/.h/.cpp/.hpp/.cc/.proto allow-list at the top of this file.
*.lib
*.a
*.so
*.dylib
*.dll
*.exe
*.pdb
*.pc
*.cmake
*.cmake.in
*.inc
*.inl
*.nt
*.Bat
*.bat
*.cmd
*.ps1
*.ico
*.rc
*.rc2
*.res
*.cs
*.csproj
*.1
*.3
*.5
*.7
*.man
*.yml
*.yaml
*.toml
*.txt
*.html
*.htm
*.xml
*.xsd
Makefile
makefile

# Exception: audit reports and ReadMe are project documentation
!*AUDIT*.txt
!ReadMe.txt
!Readonly.txt


# ===== Visual Studio / MSBuild user state ===================================
.vs/
*.suo
*.sdf
*.opensdf
*.opendb
*.aps
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.cachefile
*.VC.db
*.VC.opendb
ipch/
*.ipch
*.db

# ===== C/C++ compiler/linker intermediates ==================================
*.obj
*.o
*.lo
*.slo
*.ilk
*.exp
*.pch
*.pdb
*.idb
*.ipdb
*.iobj
*.res
*.tlog
*.tlb
*.tli
*.tlh
*.lastbuildstate
*.unsuccessfulbuild
*.recipe
*.FileListAbsolute.txt
*.lib
*.a
*.la
*.exe
*.dll
*.so
*.dylib

# ===== Generated proto output (regenerate via protoc) =======================
*.pb.cc
*.pb.h
ProtoFile_Debug/
ProtoFile_Release/

# ===== vcpkg ================================================================
vcpkg_installed/

# ===== Per-user runtime state of OrikaServer ===============================
# Page-layout JSONs saved by the server next to the .exe (GUID-named).
# These are user data, not source - persist in DB or %PROGRAMDATA% instead.
OrikaServer/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-*.json
error_log*.txt
*.log

# ===== Misc OS / editor =====================================================
.DS_Store
Thumbs.db
desktop.ini
*~
*.swp
*.swo
.idea/

# ===== Test reports / coverage ==============================================
TEST*.xml
*.coverage
*.coveragexml
coverage/

# ===== Node / Python / Java (kept from prior .gitignore) ====================
node_modules/
dist/
target/
*.class
*.py[cod]
*.jar

# ===== Large media (kept from prior .gitignore) =============================
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv
